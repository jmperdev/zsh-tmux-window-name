#!/usr/bin/env zsh

emulate -L zsh

typeset -gr __zsh_tmux_window_name_plugin_dir=${0:A:h:h}
source "$__zsh_tmux_window_name_plugin_dir/lib/zsh-tmux-window-name-common.zsh"

window_id="$1"

[[ -n $window_id ]] || exit 0
(( ${+commands[tmux]} )) || exit 0

__zsh_tmux_window_name_refresh "$window_id"
